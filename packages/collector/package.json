{
  "name": "harness-craft",
  "version": "0.1.0",
  "description": "Collects your Claude Code and Codex harness (MCP, skills, hooks, agents) into a local profile JSON. No network.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "harness-craft": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-share-template.mjs",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p share/tsconfig.json",
    "test": "pnpm run build && node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@harness-craft/schema": "workspace:*",
    "@harness-craft/sheet": "workspace:*",
    "@harness-craft/sheet-ui": "workspace:*",
    "@types/node": "^20.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
