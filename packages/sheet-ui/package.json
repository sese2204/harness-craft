{
  "name": "@harness-craft/sheet-ui",
  "version": "0.1.0",
  "private": true,
  "description": "React display of the character sheet model. Ships TSX and CSS Modules as source (no build step); consumers transpile it.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./pixel": "./src/pixel.tsx",
    "./base.css": "./src/base.css",
    "./fonts/*": "./fonts/*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@harness-craft/sheet": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0"
  }
}
