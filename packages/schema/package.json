{
  "name": "@harness-craft/schema",
  "version": "0.1.0",
  "private": true,
  "description": "Types of harness-profile.json (docs/collector-spec.md). Types only, no runtime code.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
